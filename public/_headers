# Cloudflare Pages security and caching headers.
# Keep CSP compatible with theme boot script, Google Fonts, and clipboard UX.
#
# Contact form (/contact):
# - The Turnstile script is only ever requested by the /contact page component, but the CSP
#   below allows https://challenges.cloudflare.com in script-src and frame-src site-wide.
#   Cloudflare Pages merges header values from every matching rule, and multiple CSP headers
#   are ENFORCED TOGETHER (intersection), so a /contact-only rule cannot loosen this policy.
#   Allowing one trusted origin globally is the simplest safe option; no other page loads it.
# - connect-src lists the deployed contact API origin (scheme + host only).
#   See infra/contact/README.md and docs/cloudflare-pages.md.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self' https://7ako2mwoa2.execute-api.us-east-1.amazonaws.com; upgrade-insecure-requests

/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=3600, must-revalidate

/robots.txt
  Cache-Control: public, max-age=3600, must-revalidate

/site.webmanifest
  Cache-Control: public, max-age=86400

/favicon.ico
  Cache-Control: public, max-age=604800, immutable

/favicon.svg
  Cache-Control: public, max-age=604800, immutable

/brand/*
  Cache-Control: public, max-age=604800, immutable

/icons/*
  Cache-Control: public, max-age=604800, immutable

/screenshots/*
  Cache-Control: public, max-age=604800, immutable

/payment-marks/*
  Cache-Control: public, max-age=604800, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable
