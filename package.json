{
  "name": "easy-payments-website",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "node scripts/generate-seo-assets.mjs && ng build",
    "build:prod": "node scripts/generate-seo-assets.mjs && ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "typecheck": "ng build --configuration development --output-path=dist/typecheck",
    "seo:assets": "node scripts/generate-seo-assets.mjs",
    "verify:static": "node scripts/verify-static-output.mjs",
    "verify:playground-api": "node scripts/verify-playground-historical.mjs",
    "verify:mock-network": "node scripts/verify-playground-mock-network.mjs",
    "serve:prod-browser": "node scripts/serve-prod-browser.mjs",
    "contact:local": "node scripts/local-contact-api.mjs",
    "contact:install": "npm --prefix infra/contact ci",
    "contact:test": "npm --prefix infra/contact test",
    "contact:typecheck": "npm --prefix infra/contact run typecheck"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.2.6",
    "@easy-payments/angular": "1.2.0",
    "@stripe/stripe-js": "^8.11.0",
    "express": "^5.1.0",
    "marked": "^15.0.12",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "@types/aws-lambda": "^8.10.147",
    "@types/express": "^5.0.1",
    "@types/node": "^22.12.0",
    "jsdom": "^28.0.0",
    "playwright": "^1.65.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
