# Contact backend configuration reference. Copy to `.env` for LOCAL experiments only.
# NEVER commit real values. In AWS these are Lambda environment variables (set by the CDK stack)
# and SSM SecureString parameters. No value below is a real secret.

# --- Stage / safety guards -------------------------------------------------------------------
# `local` or `test` = developer machine. Anything else (or unset!) is treated as PRODUCTION.
STAGE=local
# Must NOT be `production` when using local-mock email.
NODE_ENV=development

# `ses` (default, real email) or `local-mock` (in-memory/console sink, never sends).
# local-mock is REFUSED unless STAGE is local/test and NODE_ENV is not production.
CONTACT_EMAIL_TRANSPORT=local-mock
# Print the full captured email to the console in local-mock mode (dev only).
CONTACT_LOCAL_MOCK_PRINT_BODY=0

# --- Email -----------------------------------------------------------------------------------
# Fixed recipient. Changing it needs no frontend change or redeploy of the website.
CONTACT_TO_EMAIL=jantvb@gmail.com
# Must be a verified SES identity (address or domain).
CONTACT_FROM_EMAIL=no-reply@example.com
SES_REGION=us-east-1

# --- Web origins / Turnstile ----------------------------------------------------------------
# Comma-separated browser origins allowed to call the API. https only in production-like stages.
CONTACT_ALLOWED_ORIGINS=http://localhost:4200
# Optional override; defaults to the hostnames of CONTACT_ALLOWED_ORIGINS.
# TURNSTILE_ALLOWED_HOSTNAMES=www.easy-payments.dev
TURNSTILE_EXPECTED_ACTION=contact

# Secrets: provide EITHER the value (local only) OR an SSM SecureString parameter name (AWS).
# Cloudflare's dummy secret below always passes and is REFUSED in production-like stages.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# TURNSTILE_SECRET_SSM_PARAM=/easy-payments/contact/prod/turnstile-secret
# >= 32 random chars, e.g. `openssl rand -hex 32`. Used for HMAC-SHA256 of client IPs.
IP_HASH_SECRET=replace-with-at-least-32-random-characters-000000
# IP_HASH_SECRET_SSM_PARAM=/easy-payments/contact/prod/ip-hash-secret

# --- Storage / limits -----------------------------------------------------------------------
GUARD_TABLE_NAME=easy-payments-contact-guard
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_MAX_SUBMISSIONS=3
RATE_LIMIT_MAX_ATTEMPTS=10
DAILY_SEND_CAP=50
